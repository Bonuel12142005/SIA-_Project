# Application Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_super_secure_production_session_secret_key_change_me

# Database Configuration (MySQL Container)
DB_HOST=db
DB_PORT=3306
DB_NAME=kambac_db
DB_USER=kambac_user
DB_PASSWORD=kambac_secure_password
DB_ROOT_PASSWORD=kambac_root_password
DB_DIALECT=mysql

# Default Administrator Account (Used on initial seed)
ADMIN_NAME=KAMBAC Administrator
ADMIN_EMAIL=admin@kambac.com
ADMIN_PASSWORD=change_this_admin_password
