<!-- Professional KAMBAC Top Navigation Bar -->
<header class="bg-forest-900 border-b border-forest-950 text-white shadow-xl sticky top-0 z-40 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- 1. Brand Logo & Name (Left) -->
      <div class="flex items-center space-x-3 flex-shrink-0">
        <a href="/dashboard" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-forest-700/80 group-hover:bg-forest-600 border border-forest-600 flex items-center justify-center shadow-md transition-all">
            <i data-lucide="shield-check" class="w-6 h-6 text-white"></i>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-white flex items-center gap-1.5 leading-tight">
              KAMBAC <span class="text-emerald-300 font-semibold text-[11px] tracking-wide uppercase px-2 py-0.5 bg-forest-950/70 rounded-full border border-forest-700/60">System</span>
            </span>
            <p class="text-[11px] text-emerald-200/80 font-medium hidden sm:block">Livestock & Cooperative Management</p>
          </div>
        </a>
      </div>

      <!-- 2. Desktop Navigation Menu Items (Center/Main) -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-1.5">
        
        <!-- 1. Overview -->
        <a href="/dashboard" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'overview')}}bg-forest-750 bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="layout-dashboard" class="w-4 h-4 {{#if (eq activeNav 'overview')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Overview</span>
        </a>

        <!-- 2. Members -->
        <a href="/members" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'members')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="users" class="w-4 h-4 {{#if (eq activeNav 'members')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Members</span>
        </a>

        <!-- 3. Loans -->
        <a href="/loans" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'loans')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="wallet" class="w-4 h-4 {{#if (eq activeNav 'loans')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Loans</span>
        </a>

        <!-- 4. Livestock Dropdown / Menu -->
        <div class="relative group">
          <a href="/dashboard#livestock-section" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 {{#if (eq activeNav 'livestock')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else if (eq activeNav 'archived')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
            <i data-lucide="rabbit" class="w-4 h-4 {{#if (eq activeNav 'livestock')}}text-emerald-300{{else if (eq activeNav 'archived')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
            <span>Livestock</span>
            <i data-lucide="chevron-down" class="w-3 h-3 text-emerald-300 opacity-70 group-hover:opacity-100"></i>
          </a>
          <!-- Dropdown Menu for Quick Navigation to Active Herd & Archived -->
          <div class="hidden group-hover:block absolute left-0 mt-1 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-gray-100 dark:border-slate-700 py-1.5 z-50 text-slate-700 dark:text-slate-200">
            <a href="/dashboard#livestock-section" class="flex items-center gap-2 px-3.5 py-2 text-xs font-medium hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-emerald-600 transition-colors">
              <i data-lucide="layout-dashboard" class="w-3.5 h-3.5 text-forest-600"></i>
              <span>Active Herd</span>
            </a>
            <a href="/livestock/archived" class="flex items-center gap-2 px-3.5 py-2 text-xs font-medium hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-amber-600 transition-colors">
              <i data-lucide="archive" class="w-3.5 h-3.5 text-amber-500"></i>
              <span>Archived Records</span>
            </a>
          </div>
        </div>

        <!-- 5. Products -->
        <a href="/products" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'products')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="shopping-bag" class="w-4 h-4 {{#if (eq activeNav 'products')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Products</span>
        </a>

        <!-- 6. Equipment -->
        <a href="/equipment" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'equipment')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="wrench" class="w-4 h-4 {{#if (eq activeNav 'equipment')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Equipment</span>
        </a>

        <!-- 7. Announcements -->
        <a href="/announcements" class="px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center gap-2 {{#if (eq activeNav 'announcements')}}bg-forest-700 text-white shadow-sm ring-1 ring-forest-500/30{{else}}text-forest-100 hover:text-white hover:bg-forest-800/80{{/if}}">
          <i data-lucide="bell-ring" class="w-4 h-4 {{#if (eq activeNav 'announcements')}}text-emerald-300{{else}}text-forest-200{{/if}}"></i>
          <span>Announcements</span>
        </a>

      </nav>

      <!-- 3. Right-Side Navigation Controls -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        
        <!-- Theme Toggle Button -->
        <button id="themeToggleBtn" type="button" title="Toggle Light / Dark Mode" class="p-2 rounded-xl text-emerald-200 hover:text-white hover:bg-forest-800/90 transition-all border border-forest-700/50 shadow-sm focus:outline-none">
          <i id="themeIconSun" data-lucide="sun" class="w-5 h-5 hidden"></i>
          <i id="themeIconMoon" data-lucide="moon" class="w-5 h-5"></i>
        </button>

        <!-- Notification Button & Dropdown Panel -->
        <div class="relative">
          <button id="notifDropdownBtn" type="button" title="Notifications" class="relative p-2 rounded-xl text-emerald-200 hover:text-white hover:bg-forest-800/90 transition-all border border-forest-700/50 shadow-sm focus:outline-none">
            <i data-lucide="bell" class="w-5 h-5"></i>
            <!-- Unread notification indicator badge -->
            <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-emerald-400 rounded-full ring-2 ring-forest-900 animate-pulse"></span>
          </button>

          <!-- Notification Dropdown Menu -->
          <div id="notifDropdownMenu" class="hidden absolute right-0 mt-2 w-80 sm:w-88 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-slate-700 py-3 z-50 text-slate-800 dark:text-slate-100">
            <div class="px-4 py-2 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-forest-700 dark:text-emerald-400">Cooperative Notifications</span>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 font-semibold">3 New</span>
            </div>
            <div class="divide-y divide-gray-100 dark:divide-slate-700/50 max-h-72 overflow-y-auto">
              <div class="px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors cursor-pointer flex gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="rabbit" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-900 dark:text-gray-100">Livestock Herd Synchronized</p>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400">Health logs and weights recorded in MySQL.</p>
                  <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">Just now</span>
                </div>
              </div>
              <div class="px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors cursor-pointer flex gap-3">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="users" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-900 dark:text-gray-100">Cooperative Member Registered</p>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400">Member records active and assigned to livestock.</p>
                  <span class="text-[10px] text-gray-400">10m ago</span>
                </div>
              </div>
              <div class="px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors cursor-pointer flex gap-3">
                <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="bell-ring" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-900 dark:text-gray-100">Livestock Vaccination Schedule</p>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400">Upcoming deworming scheduled for Naujan herd.</p>
                  <span class="text-[10px] text-gray-400">1h ago</span>
                </div>
              </div>
            </div>
            <div class="px-4 pt-2 border-t border-gray-100 dark:border-slate-700 text-center">
              <a href="/announcements" class="text-xs font-semibold text-forest-700 dark:text-emerald-400 hover:underline">View all notifications</a>
            </div>
          </div>
        </div>

        <!-- Administrator Profile Avatar & Dropdown -->
        <div class="relative pl-1 sm:pl-2">
          <button id="userProfileBtn" type="button" class="flex items-center space-x-2.5 p-1 rounded-xl hover:bg-forest-800/80 transition-all border border-transparent hover:border-forest-700/50 focus:outline-none">
            <!-- Circular green profile avatar with initials -->
            <div class="w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm border-2 border-emerald-400 shadow-sm">
              <span>{{#if currentUser.initials}}{{ currentUser.initials }}{{else}}AD{{/if}}</span>
            </div>
            <div class="text-left hidden md:block pr-1">
              <p class="text-xs font-bold text-white leading-tight">{{ currentUser.name }}</p>
              <p class="text-[11px] text-emerald-300 font-medium capitalize leading-tight">{{ currentUser.role }}</p>
            </div>
            <i data-lucide="chevron-down" class="w-4 h-4 text-emerald-200 hidden md:block"></i>
          </button>

          <!-- Administrator Profile Dropdown Menu -->
          <div id="userProfileMenu" class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-slate-700 py-2 z-50 text-slate-800 dark:text-slate-100">
            <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700">
              <p class="text-xs font-bold text-gray-900 dark:text-gray-100">{{ currentUser.name }}</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 truncate">{{ currentUser.email }}</p>
              <span class="inline-block mt-1 text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-forest-100 dark:bg-forest-900/60 text-forest-800 dark:text-emerald-300 border border-forest-200 dark:border-forest-700">
                {{ currentUser.role }}
              </span>
            </div>

            <div class="py-1">
              <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-forest-700 dark:hover:text-emerald-400 transition-colors">
                <i data-lucide="user" class="w-4 h-4 text-forest-600 dark:text-emerald-400"></i>
                <span>My Profile</span>
              </a>
              <a href="/settings" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-forest-700 dark:hover:text-emerald-400 transition-colors">
                <i data-lucide="settings" class="w-4 h-4 text-forest-600 dark:text-emerald-400"></i>
                <span>Account Settings</span>
              </a>
            </div>

            <div class="border-t border-gray-100 dark:border-slate-700 pt-1">
              <a href="/logout" class="flex items-center gap-2.5 px-4 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                <span>Logout</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Mobile Hamburger Button -->
        <button id="mobileNavToggleBtn" type="button" title="Toggle Navigation Menu" class="lg:hidden p-2 rounded-xl text-emerald-200 hover:text-white hover:bg-forest-800/90 transition-all border border-forest-700/50 focus:outline-none">
          <i id="mobileMenuOpenIcon" data-lucide="menu" class="w-5 h-5"></i>
          <i id="mobileMenuCloseIcon" data-lucide="x" class="w-5 h-5 hidden"></i>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile & Tablet Responsive Navigation Drawer -->
  <div id="mobileNavDrawer" class="hidden lg:hidden border-t border-forest-800/80 bg-forest-950/95 backdrop-blur-md px-4 pt-3 pb-5 space-y-1 transition-all">
    <a href="/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'overview')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="layout-dashboard" class="w-4 h-4 text-emerald-300"></i>
      <span>Overview</span>
    </a>
    <a href="/members" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'members')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="users" class="w-4 h-4 text-emerald-300"></i>
      <span>Members</span>
    </a>
    <a href="/loans" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'loans')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="wallet" class="w-4 h-4 text-emerald-300"></i>
      <span>Loans</span>
    </a>
    <a href="/dashboard#livestock-section" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'livestock')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="rabbit" class="w-4 h-4 text-emerald-300"></i>
      <span>Active Livestock Herd</span>
    </a>
    <a href="/livestock/archived" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'archived')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="archive" class="w-4 h-4 text-amber-400"></i>
      <span>Archived Records</span>
    </a>
    <a href="/products" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'products')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="shopping-bag" class="w-4 h-4 text-emerald-300"></i>
      <span>Products</span>
    </a>
    <a href="/equipment" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'equipment')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="wrench" class="w-4 h-4 text-emerald-300"></i>
      <span>Equipment</span>
    </a>
    <a href="/announcements" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium {{#if (eq activeNav 'announcements')}}bg-forest-700 text-white{{else}}text-forest-100 hover:bg-forest-800/80 hover:text-white{{/if}}">
      <i data-lucide="bell-ring" class="w-4 h-4 text-emerald-300"></i>
      <span>Announcements</span>
    </a>
  </div>
</header>
