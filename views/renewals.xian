{{> head}}
<body class="app-body admin-portal">
  <div class="app-shell">
    {{> admin-sidebar}}
    <main class="app-main">
      <header class="topbar"><span class="breadcrumb">Workspace <span>/</span> Renewals</span><span class="topbar-label">MEMBERSHIP FEES</span></header>
      <section class="page-content">
        <div class="page-heading"><div><p class="eyebrow">MEMBERSHIP CYCLE</p><h1>Renewal tracking</h1><p class="page-subtitle">Record payments and monitor each member's annual renewal date.</p></div><a class="button button-secondary" href="/members">Back to Member Directory</a></div>
        <section class="stats-grid renewal-stats" aria-label="Renewal overview">
          <article class="stat-card"><div class="stat-top"><span>Current</span><span class="stat-icon">✓</span></div><strong>{{currentCount}}</strong><small>More than 30 days remaining</small></article>
          <article class="stat-card"><div class="stat-top"><span>Due soon</span><span class="stat-icon">◷</span></div><strong>{{dueSoonCount}}</strong><small>Due within 30 days</small></article>
          <article class="stat-card"><div class="stat-top"><span>Overdue</span><span class="stat-icon">!</span></div><strong>{{overdueCount}}</strong><small>Renewal date has passed</small></article>
        </section>
        <section class="directory-card">
          <div class="directory-heading"><div><h2>Member renewals</h2><p class="muted-copy">Renewal periods are annual; enter the amount actually received.</p></div></div>
          <div class="table-wrap">
            <table class="member-table renewal-table">
              <thead><tr><th>MEMBER</th><th>LAST PAYMENT</th><th>AMOUNT</th><th>RENEW BY</th><th>STATUS</th><th>RECORD PAYMENT</th></tr></thead>
              <tbody>
                {{#each members}}
                <tr>
                  <td><div class="member-identity"><span class="member-avatar">{{initials}}</span><span><strong>{{fullName}}</strong><small>{{memberId}}</small></span></div></td>
                  <td>{{#if lastPaidAt}}{{lastPaidAt}}{{else}}No payment recorded{{/if}}</td>
                  <td>{{#if lastPaymentAmount}}₱{{lastPaymentAmount}}{{else}}—{{/if}}</td>
                  <td>{{renewalDate}}</td>
                  <td><span class="status-badge {{#if isOverdue}}status-overdue{{else}}{{#if isDueSoon}}status-due-soon{{else}}status-active{{/if}}{{/if}}"><i></i>{{renewalStatus}}</span></td>
                  <td>
                    <form class="payment-form" method="POST" action="/members/{{id}}/payments">
                      <label><span class="sr-only">Payment amount for {{fullName}}</span><input name="amount" type="number" min="0.01" max="99999999.99" step="0.01" placeholder="Amount" required></label>
                      <label><span class="sr-only">Payment date for {{fullName}}</span><input name="paidAt" type="date" value="{{../today}}" max="{{../today}}" required></label>
                      <button class="button button-primary payment-submit" type="submit">Record</button>
                    </form>
                  </td>
                </tr>
                {{else}}
                <tr><td colspan="6"><div class="empty-state"><span class="empty-icon">↻</span><strong>No member records</strong><p>Add members to track annual renewals.</p><a class="text-link" href="/members/new">Add a member <span aria-hidden="true">→</span></a></div></td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </section>
      </section>
    </main>
  </div>
{{> footer }}
