{{> head}}
<body class="app-body auth-page">
  <div class="auth-card">
    <a class="brand auth-brand" href="/"><span class="brand-mark">K</span><span>KAMBAC<span class="brand-accent">.</span></span></a>
    <p class="eyebrow">MEMBER ACCOUNT</p>
    <h1>Create your account</h1>
    <p class="page-subtitle auth-subtitle">Create your secure login first. You will complete the membership application form next.</p>
    {{#if errorMessage}}<p class="form-alert" role="alert">{{errorMessage}}</p>{{/if}}
    <form class="auth-form" method="POST" action="/register">
      <label class="form-field"><span>Full name <b>*</b></span><input type="text" name="name" value="{{form.name}}" minlength="2" maxlength="120" autocomplete="name" required></label>
      <label class="form-field"><span>Username <b>*</b></span><input type="text" name="username" value="{{form.username}}" minlength="3" maxlength="32" pattern="[A-Za-z0-9._-]{3,32}" autocomplete="username" required><small class="field-hint">Use 3–32 letters, numbers, dots, dashes, or underscores.</small></label>
      <label class="form-field"><span>Email address <b>*</b></span><input type="email" name="email" value="{{form.email}}" maxlength="254" autocomplete="email" required></label>
      <label class="form-field"><span>Password <b>*</b></span><input type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" required><small class="field-hint">Use at least 12 characters.</small></label>
      <button class="button button-primary auth-submit" type="submit">Create account and continue</button>
      <a class="auth-login-link" href="/login">Already have an account? Log in</a>
    </form>
  </div>
{{> footer }}
