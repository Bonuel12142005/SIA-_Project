{{> head }}
{{> nav }}

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  {{#if success_msg}}
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
      <p class="font-medium text-sm">{{ success_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  {{#if error_msg}}
  <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
      <p class="font-medium text-sm">{{ error_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 gap-4 border-b border-gray-200">
    <div>
      <div class="flex items-center gap-2">
        <a href="/dashboard" class="text-gray-400 hover:text-gray-600"><i data-lucide="arrow-left" class="w-5 h-5"></i></a>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Archived Livestock Records</h1>
      </div>
      <p class="text-sm text-gray-500 mt-1 ml-7">Archived animals (sold, transferred, butchered, or deceased). Records are safely retained in MySQL and can be restored anytime.</p>
    </div>
  </div>

  <!-- Archived Table / Grid -->
  <div class="mt-8">
    {{#if archivedItems.length}}
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
          <thead class="bg-gray-50 text-xs font-bold text-gray-500 uppercase tracking-wider">
            <tr>
              <th class="px-6 py-4">Livestock Code</th>
              <th class="px-6 py-4">Animal Details</th>
              <th class="px-6 py-4">Owner</th>
              <th class="px-6 py-4">Archive Date</th>
              <th class="px-6 py-4">Reason</th>
              <th class="px-6 py-4">Estimated Value</th>
              <th class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each archivedItems}}
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="px-6 py-4 font-mono font-bold text-forest-700">{{ this.livestock_code }}</td>
              <td class="px-6 py-4">
                <div class="font-bold text-gray-900">{{ this.animal_name }}</div>
                <div class="text-xs text-gray-500">{{ this.animal_type }} &bull; {{ this.breed }}</div>
              </td>
              <td class="px-6 py-4">
                <div class="font-medium text-gray-800">{{ this.owner.first_name }} {{ this.owner.last_name }}</div>
                <div class="text-xs text-gray-400 font-mono">{{ this.owner.member_code }}</div>
              </td>
              <td class="px-6 py-4 text-gray-600 text-xs">{{ this.archive_date }}</td>
              <td class="px-6 py-4">
                <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                  {{ this.archive_reason }}
                </span>
              </td>
              <td class="px-6 py-4 font-bold text-gray-800">₱{{ this.formatted_value }}</td>
              <td class="px-6 py-4 text-right">
                <form action="/livestock/{{ this.id }}/restore" method="POST" class="inline" onsubmit="return confirm('Restore {{ this.livestock_code }} back to active herd?')">
                  <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-colors shadow-sm">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                    <span>Restore</span>
                  </button>
                </form>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    {{else}}
    <div class="bg-white rounded-2xl border border-dashed border-gray-300 p-12 text-center">
      <div class="w-16 h-16 rounded-full bg-gray-100 text-gray-400 mx-auto flex items-center justify-center mb-4">
        <i data-lucide="archive" class="w-8 h-8"></i>
      </div>
      <h3 class="text-lg font-bold text-gray-800">No archived livestock records</h3>
      <p class="text-sm text-gray-500 mt-1 max-w-md mx-auto">Active livestock records will appear here if archived due to sales, transfers, or mortality.</p>
      <a href="/dashboard" class="mt-5 inline-flex items-center gap-2 px-4 py-2 bg-forest-600 hover:bg-forest-700 text-white font-medium text-xs rounded-xl shadow-sm">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Active Dashboard
      </a>
    </div>
    {{/if}}
  </div>

</main>

{{> footer }}
