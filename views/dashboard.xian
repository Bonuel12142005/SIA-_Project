{{> head}}
<body class="app-body {{#if isAdmin}}admin-portal{{else}}member-portal{{/if}}">
  <div class="app-shell">
    {{#if isAdmin}}
    {{> admin-sidebar}}
    {{else}}
    <aside class="app-sidebar">
      <a class="brand" href="/dashboard"><span class="brand-mark">K</span><span>KAMBAC<span class="brand-accent">.</span></span></a>
      <p class="sidebar-label">{{#if isAdmin}}WORKSPACE{{else}}MEMBER PORTAL{{/if}}</p>
      <nav class="sidebar-nav" aria-label="Main navigation">
        <a class="nav-link is-active" href="/dashboard"><span class="nav-icon">⌂</span>Dashboard</a>
        {{#if isAdmin}}
        <a class="nav-link" href="/members"><span class="nav-icon">♙</span>Member directory</a>
        <a class="nav-link" href="/members/renewals"><span class="nav-icon">↻</span>Renewals</a>
        <a class="nav-link" href="/admin/applications"><span class="nav-icon">✓</span>Applications <span class="nav-count">{{pendingApplications}}</span></a>
        <a class="nav-link" href="/members/archive"><span class="nav-icon">◷</span>Archive</a>
        <a class="nav-link" href="/admin/audit"><span class="nav-icon">≡</span>Audit trail</a>
        {{else}}
        <a class="nav-link" href="/member/id-card"><span class="nav-icon">▣</span>Digital ID</a>
        <a class="nav-link" href="/member/profile"><span class="nav-icon">♙</span>My Profile</a>
        {{/if}}
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-user"><span class="user-avatar">{{currentInitials}}</span><span><strong>{{current.name}}</strong><small>{{current.roleLabel}}</small></span></div>
        <a class="logout-link" href="/logout">Log out <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
    {{/if}}

    <main class="app-main">
      <header class="topbar"><span class="breadcrumb">Workspace <span>/</span> Dashboard</span><span class="topbar-label">{{#if isAdmin}}ADMINISTRATION{{else}}MEMBER PORTAL{{/if}}</span></header>
      <section class="page-content">
        <div class="page-heading">
          <div><p class="eyebrow">{{#if isAdmin}}ORGANIZATION OVERVIEW{{else}}MEMBER SPACE{{/if}}</p><h1>Good to see you, {{current.name}}</h1><p class="page-subtitle">{{#if isAdmin}}A clear view of your community and member records.{{else}}Your KAMBAC membership information at a glance.{{/if}}</p></div>
          {{#if isAdmin}}<a class="button button-primary" href="/members/new"><span aria-hidden="true">＋</span> Register member</a>{{else}}<div class="page-actions"><a class="button button-secondary" href="/member/profile">Edit profile</a><a class="button button-primary" href="/member/id-card">View digital ID</a></div>{{/if}}
        </div>

        {{#if isAdmin}}
        <section class="stats-grid" aria-label="Membership overview">
          <article class="stat-card"><div class="stat-top"><span>Total members</span><span class="stat-icon">♙</span></div><strong>{{totalMembers}}</strong><small>Current member records</small></article>
          <article class="stat-card"><div class="stat-top"><span>Active</span><span class="stat-icon">✓</span></div><strong>{{activeMembers}}</strong><small>Active memberships</small></article>
          <article class="stat-card"><div class="stat-top"><span>Inactive</span><span class="stat-icon">◌</span></div><strong>{{inactiveMembers}}</strong><small>Inactive memberships</small></article>
          <article class="stat-card"><div class="stat-top"><span>Suspended</span><span class="stat-icon">!</span></div><strong>{{suspendedMembers}}</strong><small>Suspended memberships</small></article>
          <a class="stat-card stat-link" href="/admin/applications"><div class="stat-top"><span>Awaiting approval</span><span class="stat-icon">✓</span></div><strong>{{pendingApplications}}</strong><small>Review member applications <span aria-hidden="true">→</span></small></a>
        </section>

        <section class="directory-card dashboard-recent">
          <div class="directory-heading"><div><h2>Recently added members</h2><p class="muted-copy">The latest records in your member directory.</p></div><a class="text-link" href="/members">View all members <span aria-hidden="true">→</span></a></div>
          <div class="table-wrap">
            <table class="member-table">
              <thead><tr><th>MEMBER</th><th>MEMBER ID</th><th>JOINED</th><th>STATUS</th><th><span class="sr-only">Member profile link</span></th></tr></thead>
              <tbody>
                {{#each recentMembers}}
                <tr>
                  <td><div class="member-identity"><span class="member-avatar">{{initials}}</span><span><strong>{{firstName}} {{lastName}}</strong><small>Member profile</small></span></div></td>
                  <td class="member-id">{{memberId}}</td><td>{{membershipDate}}</td>
                  <td><span class="status-badge {{#if isActive}}status-active{{else}}{{#if isSuspended}}status-suspended{{else}}status-inactive{{/if}}{{/if}}"><i></i>{{status}}</span></td>
                  <td><a class="table-action" href="/members/{{id}}">View profile</a></td>
                </tr>
                {{else}}
                <tr><td colspan="5"><div class="empty-state"><span class="empty-icon">♙</span><strong>Your directory is ready</strong><p>Add your first member record to get started.</p><a class="text-link" href="/members/new">Add a member <span aria-hidden="true">→</span></a></div></td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </section>
        {{else}}
        <section class="welcome-card member-welcome">
          <div class="welcome-copy"><p class="eyebrow">WELCOME TO YOUR MEMBER PORTAL</p><h2>Rooted in community.<br>Growing together.</h2><p>Keep your membership information close and stay connected with KAMBAC.</p></div>
          <div class="welcome-emblem" aria-hidden="true">K</div>
        </section>
        <section class="member-summary" id="membership">
          <div class="section-heading"><div><h2>Your membership</h2><p class="muted-copy">Your current account and membership standing.</p></div></div>
          <div class="member-summary-grid">
            <article class="member-summary-card"><span class="summary-label">MEMBER ID</span><strong class="summary-id">{{current.memberId}}</strong><small>Your unique KAMBAC identifier</small></article>
            <article class="member-summary-card"><span class="summary-label">MEMBERSHIP STATUS</span><strong><span class="status-badge {{#if current.isActive}}status-active{{else}}status-inactive{{/if}}"><i></i>{{current.status}}</span></strong><small>Contact the KAMBAC office if this needs updating.</small></article>
            <article class="member-summary-card"><span class="summary-label">MEMBER SINCE</span><strong>{{current.membershipDate}}</strong><small>Your membership start date</small></article>
            <article class="member-summary-card"><span class="summary-label">RENEWAL DATE</span><strong>{{current.renewalDate}}</strong><small>{{current.renewalLabel}}</small></article>
          </div>
          <p class="member-note">For help with your profile or membership details, please contact an authorized KAMBAC administrator.</p>
          <div class="member-portal-actions"><a class="quick-card" href="/member/id-card"><span class="quick-icon">▣</span><span><strong>Digital member ID</strong><small>View and print your QR-enabled membership card</small></span><span class="quick-arrow" aria-hidden="true">→</span></a><a class="quick-card" href="/member/profile"><span class="quick-icon">♙</span><span><strong>Update profile</strong><small>Keep your contact information up to date</small></span><span class="quick-arrow" aria-hidden="true">→</span></a></div>
        </section>
        {{/if}}
      </section>
    </main>
  </div>
{{> footer }}
