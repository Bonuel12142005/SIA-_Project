{{> head }}
{{> nav }}

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Flash Messages / Toast Alerts -->
  {{#if success_msg}}
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-sm transition-all duration-300">
    <div class="flex items-center space-x-3">
      <div class="p-1.5 bg-emerald-100 rounded-lg text-emerald-700">
        <i data-lucide="check-circle-2" class="w-5 h-5"></i>
      </div>
      <p class="font-medium text-sm">{{ success_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  {{#if error_msg}}
  <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 flex items-center justify-between shadow-sm transition-all duration-300">
    <div class="flex items-center space-x-3">
      <div class="p-1.5 bg-red-100 rounded-lg text-red-700">
        <i data-lucide="alert-circle" class="w-5 h-5"></i>
      </div>
      <p class="font-medium text-sm">{{ error_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  <!-- Page Header & Action Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 gap-4 border-b border-gray-200">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Livestock Overview</h1>
      <p class="text-sm text-gray-500 mt-1">Real-time inventory and health monitoring for cooperative members</p>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="openAddModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-forest-600 hover:bg-forest-700 text-white font-medium text-sm rounded-xl shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Add Livestock</span>
      </button>
    </div>
  </div>

  <!-- SECTION 4: STATISTIC CARDS (4 CARDS MATCHING SCREENSHOT 2) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 my-8">
    
    <!-- Card 1: TOTAL LIVESTOCK -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">TOTAL LIVESTOCK</p>
          <h3 class="text-3xl font-black text-gray-900 mt-2">{{ stats.totalLivestock }}</h3>
          <p class="text-xs text-forest-600 font-medium mt-1 flex items-center gap-1">
            <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Active herd inventory
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-forest-50 text-forest-600 flex items-center justify-center">
          <i data-lucide="database" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- Card 2: HEALTHY / ACTIVE -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">HEALTHY / ACTIVE</p>
          <h3 class="text-3xl font-black text-emerald-600 mt-2">{{ stats.healthyCount }}</h3>
          <p class="text-xs text-emerald-600 font-medium mt-1 flex items-center gap-1">
            <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Optimal health condition
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <i data-lucide="activity" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- Card 3: NEEDS MONITORING -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">NEEDS MONITORING</p>
          <h3 class="text-3xl font-black text-amber-500 mt-2">{{ stats.needsMonitoringCount }}</h3>
          <p class="text-xs text-amber-600 font-medium mt-1 flex items-center gap-1">
            <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i> Observation / Treatment
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center">
          <i data-lucide="stethoscope" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- Card 4: ESTIMATED VALUE -->
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">ESTIMATED VALUE</p>
          <h3 class="text-2xl sm:text-3xl font-black text-forest-700 mt-2">₱{{ stats.formattedEstimatedValue }}</h3>
          <p class="text-xs text-forest-600 font-medium mt-1 flex items-center gap-1">
            <i data-lucide="badge-percent" class="w-3.5 h-3.5"></i> Combined asset valuation
          </p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-forest-50 text-forest-700 flex items-center justify-center">
          <i data-lucide="coins" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

  </div>

  <!-- SECTION 6: ACTIVE LIVESTOCK GRID -->
  <div id="livestock-section" class="mt-10 scroll-mt-20">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
          <span>Active Livestock Herd</span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-forest-100 text-forest-800">
            {{ livestockList.length }} Registered
          </span>
        </h2>
        <p class="text-xs text-gray-500 mt-0.5">Click any card to inspect medical history, weight logs, or modify record</p>
      </div>
    </div>

    {{#if livestockList.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {{#each livestockList}}
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col">
        
        <!-- Card Header -->
        <div class="p-5 border-b border-gray-100 bg-slate-50/50 flex items-start justify-between">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-200 text-forest-700">
                {{ this.livestock_code }}
              </span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-200 text-slate-700">
                {{ this.animal_type }}
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mt-2">{{ this.animal_name }}</h3>
            <p class="text-xs text-gray-500">{{ this.breed }} &bull; {{ this.sex }}</p>
          </div>

          <!-- Health Status Badge -->
          <div>
            {{#if this.isHealthy}}
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              {{ this.health_status }}
            </span>
            {{else}}
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
              {{ this.health_status }}
            </span>
            {{/if}}
          </div>
        </div>

        <!-- Card Body / Details -->
        <div class="p-5 space-y-3 text-sm flex-grow">
          <div class="flex items-center justify-between text-gray-600">
            <span class="text-xs text-gray-400 font-medium">Owner / Member:</span>
            <span class="font-semibold text-gray-800">{{ this.owner.first_name }} {{ this.owner.last_name }}</span>
          </div>
          <div class="flex items-center justify-between text-gray-600">
            <span class="text-xs text-gray-400 font-medium">Approximate Age:</span>
            <span class="font-medium text-gray-700">{{ this.age }}</span>
          </div>
          <div class="flex items-center justify-between text-gray-600">
            <span class="text-xs text-gray-400 font-medium">Current Weight:</span>
            <span class="font-bold text-forest-700">{{ this.current_weight }} kg</span>
          </div>
          <div class="flex items-center justify-between text-gray-600 pt-2 border-t border-gray-100">
            <span class="text-xs text-gray-400 font-medium">Estimated Value:</span>
            <span class="text-base font-extrabold text-forest-800">₱{{ this.formatted_value }}</span>
          </div>
        </div>

        <!-- Card Actions (View, Edit, Archive) -->
        <div class="p-4 bg-gray-50/70 border-t border-gray-100 flex items-center justify-between gap-2">
          <button onclick="viewLivestockDetails({{ this.id }})" class="flex-1 py-2 px-3 text-xs font-semibold rounded-lg bg-white border border-gray-200 text-gray-700 hover:bg-forest-50 hover:text-forest-700 hover:border-forest-200 transition-colors flex items-center justify-center gap-1 shadow-sm">
            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
            <span>View</span>
          </button>
          
          <button onclick="editLivestock({{ this.id }})" class="flex-1 py-2 px-3 text-xs font-semibold rounded-lg bg-white border border-gray-200 text-gray-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 transition-colors flex items-center justify-center gap-1 shadow-sm">
            <i data-lucide="edit" class="w-3.5 h-3.5"></i>
            <span>Edit</span>
          </button>

          <button onclick="confirmArchive({{ this.id }}, '{{ this.livestock_code }}', '{{ this.animal_name }}')" class="py-2 px-3 text-xs font-semibold rounded-lg bg-white border border-gray-200 text-gray-500 hover:bg-red-50 hover:text-red-700 hover:border-red-200 transition-colors flex items-center justify-center gap-1 shadow-sm" title="Archive Livestock">
            <i data-lucide="archive" class="w-3.5 h-3.5"></i>
          </button>
        </div>

      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="bg-white rounded-2xl border border-dashed border-gray-300 p-12 text-center">
      <div class="w-16 h-16 rounded-full bg-forest-50 text-forest-600 mx-auto flex items-center justify-center mb-4">
        <i data-lucide="inbox" class="w-8 h-8"></i>
      </div>
      <h3 class="text-lg font-bold text-gray-800">No active livestock records yet</h3>
      <p class="text-sm text-gray-500 mt-1 max-w-md mx-auto">Get started by clicking the "Add Livestock" button above to register members' animals into the system.</p>
      <button onclick="openAddModal()" class="mt-5 inline-flex items-center gap-2 px-4 py-2 bg-forest-600 hover:bg-forest-700 text-white font-medium text-xs rounded-xl shadow-sm">
        <i data-lucide="plus" class="w-4 h-4"></i> Add First Livestock
      </button>
    </div>
    {{/if}}
  </div>

</main>

<!-- SECTION 5 & 7: ADD LIVESTOCK MODAL (MATCHING SCREENSHOT 1) -->
<div id="addLivestockModal" class="fixed inset-0 z-50 hidden modal-backdrop overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-gray-100">
      
      <!-- Modal Header -->
      <div class="bg-forest-800 px-6 py-4 flex items-center justify-between text-white">
        <div class="flex items-center space-x-2">
          <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-300"></i>
          <h3 class="text-lg font-bold tracking-tight">Register New Livestock</h3>
        </div>
        <button onclick="closeAddModal()" class="text-forest-200 hover:text-white transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Registration Form -->
      <form action="/livestock" method="POST" class="p-6 space-y-4">
        
        <!-- Owner / Member Dropdown -->
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Owner / Member <span class="text-red-500">*</span></label>
          <select name="member_id" required class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none">
            <option value="" disabled selected>-- Select Member / Owner --</option>
            {{#each members}}
            <option value="{{ this.id }}">{{ this.first_name }} {{ this.last_name }} ({{ this.member_code }})</option>
            {{/each}}
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Animal Name / Tag -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Animal Name / Tag</label>
            <input type="text" name="animal_name" placeholder="e.g. Bessie / Tag #042" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>

          <!-- Animal Type Dropdown -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Animal Type <span class="text-red-500">*</span></label>
            <select name="animal_type" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none">
              <option value="" disabled selected>Select Animal Type</option>
              <option value="Cattle">Cattle / Cow</option>
              <option value="Carabao">Carabao (Water Buffalo)</option>
              <option value="Goat">Goat</option>
              <option value="Pig">Swine / Pig</option>
              <option value="Sheep">Sheep</option>
              <option value="Poultry">Poultry</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Breed -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Breed</label>
            <input type="text" name="breed" placeholder="e.g. Brahman, Boer, Landrace" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>

          <!-- Sex -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Sex <span class="text-red-500">*</span></label>
            <select name="sex" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none">
              <option value="Female">Female</option>
              <option value="Male" selected>Male</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Date Acquired -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Date Acquired <span class="text-red-500">*</span></label>
            <input type="date" name="date_acquired" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>

          <!-- Birth Date (Optional) -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Birth Date (Optional)</label>
            <input type="date" name="birth_date" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Initial Weight (kg) -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Initial Weight (kg) <span class="text-red-500">*</span></label>
            <input type="number" step="0.01" min="0" name="initial_weight" placeholder="0.00" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>

          <!-- Health Condition Dropdown -->
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Health Condition <span class="text-red-500">*</span></label>
            <select name="health_status" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none">
              <option value="Healthy" selected>Healthy</option>
              <option value="Needs Monitoring">Needs Monitoring</option>
              <option value="Under Treatment">Under Treatment</option>
              <option value="Critical">Critical</option>
              <option value="Vaccinated">Vaccinated</option>
            </select>
          </div>
        </div>

        <!-- Estimated Value (₱) -->
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Estimated Value (₱) <span class="text-red-500">*</span></label>
          <div class="relative rounded-xl">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500 font-bold">
              ₱
            </div>
            <input type="number" step="0.01" min="0" name="estimated_value" placeholder="0.00" required class="w-full pl-8 pr-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Modal Actions -->
        <div class="pt-4 border-t border-gray-200 flex items-center justify-end gap-3">
          <button type="button" onclick="closeAddModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2 bg-forest-600 hover:bg-forest-700 text-white rounded-xl text-sm font-semibold shadow-md transition-all">
            Save Record
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<!-- SECTION 7: VIEW LIVESTOCK DETAILS MODAL -->
<div id="viewLivestockModal" class="fixed inset-0 z-50 hidden modal-backdrop overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full border border-gray-100">
      
      <!-- Modal Header -->
      <div class="bg-forest-900 px-6 py-4 flex items-center justify-between text-white">
        <div class="flex items-center space-x-2">
          <i data-lucide="file-text" class="w-5 h-5 text-emerald-300"></i>
          <div>
            <h3 id="viewTitle" class="text-lg font-bold tracking-tight">Livestock Details</h3>
            <p id="viewSubtitle" class="text-xs text-forest-200 font-mono"></p>
          </div>
        </div>
        <button onclick="closeViewModal()" class="text-forest-200 hover:text-white transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Body Tabs -->
      <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto">
        
        <!-- Info Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 p-4 bg-slate-50 rounded-xl border border-gray-200 text-sm">
          <div>
            <span class="block text-xs font-semibold text-gray-400">Animal Type</span>
            <span id="viewType" class="font-bold text-gray-800"></span>
          </div>
          <div>
            <span class="block text-xs font-semibold text-gray-400">Breed</span>
            <span id="viewBreed" class="font-bold text-gray-800"></span>
          </div>
          <div>
            <span class="block text-xs font-semibold text-gray-400">Sex</span>
            <span id="viewSex" class="font-bold text-gray-800"></span>
          </div>
          <div>
            <span class="block text-xs font-semibold text-gray-400">Current Weight</span>
            <span id="viewWeight" class="font-bold text-forest-700"></span>
          </div>
          <div>
            <span class="block text-xs font-semibold text-gray-400">Age</span>
            <span id="viewAge" class="font-bold text-gray-800"></span>
          </div>
          <div>
            <span class="block text-xs font-semibold text-gray-400">Estimated Value</span>
            <span id="viewValue" class="font-bold text-forest-800"></span>
          </div>
          <div class="col-span-2 sm:col-span-3 pt-2 border-t border-gray-200 flex justify-between items-center">
            <div>
              <span class="block text-xs font-semibold text-gray-400">Registered Owner</span>
              <span id="viewOwner" class="font-bold text-gray-800"></span>
            </div>
            <div>
              <span class="block text-xs font-semibold text-gray-400">Date Acquired</span>
              <span id="viewDateAcquired" class="font-medium text-gray-700"></span>
            </div>
          </div>
        </div>

        <!-- Health Records Section -->
        <div>
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i data-lucide="heart-pulse" class="w-4 h-4 text-emerald-600"></i> Medical & Health History
          </h4>
          <div id="viewHealthList" class="space-y-2">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Weight History Section -->
        <div>
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-2 flex items-center gap-1.5">
            <i data-lucide="scale" class="w-4 h-4 text-forest-700"></i> Weight Growth Logs
          </h4>
          <div id="viewWeightList" class="space-y-2">
            <!-- Dynamically populated -->
          </div>
        </div>

      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end">
        <button onclick="closeViewModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-xl text-sm font-semibold transition-colors">
          Close
        </button>
      </div>

    </div>
  </div>
</div>

<!-- SECTION 6: EDIT LIVESTOCK MODAL -->
<div id="editLivestockModal" class="fixed inset-0 z-50 hidden modal-backdrop overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-gray-100">
      
      <div class="bg-blue-800 px-6 py-4 flex items-center justify-between text-white">
        <div class="flex items-center space-x-2">
          <i data-lucide="edit-3" class="w-5 h-5 text-blue-200"></i>
          <div>
            <h3 class="text-lg font-bold tracking-tight">Edit Livestock Information</h3>
            <p id="editSubtitle" class="text-xs text-blue-200 font-mono"></p>
          </div>
        </div>
        <button onclick="closeEditModal()" class="text-blue-200 hover:text-white transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="editForm" method="POST" class="p-6 space-y-4">
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Animal Name / Tag</label>
            <input type="text" id="editAnimalName" name="animal_name" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Breed</label>
            <input type="text" id="editBreed" name="breed" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Current Weight (kg)</label>
            <input type="number" step="0.01" id="editWeight" name="current_weight" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Health Status</label>
            <select id="editHealth" name="health_status" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none">
              <option value="Healthy">Healthy</option>
              <option value="Needs Monitoring">Needs Monitoring</option>
              <option value="Under Treatment">Under Treatment</option>
              <option value="Critical">Critical</option>
              <option value="Vaccinated">Vaccinated</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Estimated Value (₱)</label>
          <input type="number" step="0.01" id="editValue" name="estimated_value" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
        </div>

        <div class="pt-2 border-t border-gray-100">
          <p class="text-xs font-bold text-gray-500 uppercase mb-2">Optional Update Logs</p>
          <div class="space-y-3">
            <div>
              <label class="block text-xs text-gray-600 mb-1">Treatment / Checkup Notes</label>
              <input type="text" name="health_treatment" placeholder="e.g. Administered Dewormer / Vitamin Shots" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
            </div>
            <div>
              <label class="block text-xs text-gray-600 mb-1">Weight Log Remarks</label>
              <input type="text" name="weight_remarks" placeholder="e.g. Monthly weight calibration" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none" />
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-gray-200 flex items-center justify-end gap-3">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-md transition-all">
            Update Livestock
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<!-- SECTION 8: ARCHIVE CONFIRMATION MODAL -->
<div id="archiveModal" class="fixed inset-0 z-50 hidden modal-backdrop overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full border border-gray-100">
      
      <div class="p-6">
        <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mb-4">
          <i data-lucide="archive" class="w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900">Archive Livestock Record?</h3>
        <p class="text-sm text-gray-500 mt-2">
          Are you sure you want to archive <strong id="archiveAnimalName"></strong> (<span id="archiveCode" class="font-mono"></span>)? 
          The record will be safely moved to the Archived section and can be restored at any time.
        </p>

        <form id="archiveForm" method="POST" class="mt-4 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Reason for Archiving</label>
            <select name="reason" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-red-500 focus:bg-white outline-none">
              <option value="Sold to Buyer">Sold to Buyer / Market</option>
              <option value="Transferred Ownership">Transferred to another Member</option>
              <option value="Harvested / Butchered">Harvested / Consumed</option>
              <option value="Deceased / Disease">Deceased (Natural / Illness)</option>
              <option value="Correction / Inactive">Data Entry Correction / Inactive</option>
            </select>
          </div>

          <div class="pt-4 border-t border-gray-200 flex items-center justify-end gap-3">
            <button type="button" onclick="closeArchiveModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors">
              Cancel
            </button>
            <button type="submit" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-semibold shadow-md transition-all">
              Archive Livestock
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
  function openAddModal() {
    document.getElementById('addLivestockModal').classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  function closeAddModal() {
    document.getElementById('addLivestockModal').classList.add('hidden');
  }

  function closeViewModal() {
    document.getElementById('viewLivestockModal').classList.add('hidden');
  }

  function closeEditModal() {
    document.getElementById('editLivestockModal').classList.add('hidden');
  }

  function closeArchiveModal() {
    document.getElementById('archiveModal').classList.add('hidden');
  }

  async function viewLivestockDetails(id) {
    try {
      const res = await fetch('/livestock/api/' + id);
      const json = await res.json();
      if (!json.success) return alert(json.message);

      const d = json.data;
      document.getElementById('viewTitle').textContent = d.animal_name + ' (' + d.livestock_code + ')';
      document.getElementById('viewSubtitle').textContent = 'Owner: ' + d.owner.first_name + ' ' + d.owner.last_name + ' • ' + d.owner.member_code;
      document.getElementById('viewType').textContent = d.animal_type;
      document.getElementById('viewBreed').textContent = d.breed || 'N/A';
      document.getElementById('viewSex').textContent = d.sex;
      document.getElementById('viewWeight').textContent = d.current_weight + ' kg';
      document.getElementById('viewAge').textContent = d.age;
      document.getElementById('viewValue').textContent = '₱' + d.formatted_value;
      document.getElementById('viewOwner').textContent = d.owner.first_name + ' ' + d.owner.last_name + ' (' + (d.owner.contact_number || 'No contact') + ')';
      document.getElementById('viewDateAcquired').textContent = d.date_acquired;

      // Render health history
      const hContainer = document.getElementById('viewHealthList');
      hContainer.innerHTML = '';
      if (d.healthRecords && d.healthRecords.length) {
        d.healthRecords.forEach(h => {
          hContainer.innerHTML += `
            <div class="p-3 bg-emerald-50/50 rounded-xl border border-emerald-100 text-xs">
              <div class="flex justify-between items-center">
                <span class="font-bold text-emerald-900">${h.health_condition}</span>
                <span class="text-gray-400 font-mono">${h.record_date}</span>
              </div>
              <p class="text-gray-700 mt-1 font-medium">${h.diagnosis || 'Checkup'}</p>
              ${h.treatment ? `<p class="text-emerald-700 mt-0.5"><span class="font-semibold">Treatment:</span> ${h.treatment}</p>` : ''}
              ${h.remarks ? `<p class="text-gray-500 mt-0.5 italic">${h.remarks}</p>` : ''}
            </div>
          `;
        });
      } else {
        hContainer.innerHTML = '<p class="text-xs text-gray-400 italic">No health records recorded yet.</p>';
      }

      // Render weight history
      const wContainer = document.getElementById('viewWeightList');
      wContainer.innerHTML = '';
      if (d.weightHistory && d.weightHistory.length) {
        d.weightHistory.forEach(w => {
          wContainer.innerHTML += `
            <div class="p-2.5 bg-gray-50 rounded-xl border border-gray-200 text-xs flex justify-between items-center">
              <div>
                <span class="font-bold text-gray-900">${w.weight} kg</span>
                ${w.remarks ? `<span class="text-gray-500 ml-2">(${w.remarks})</span>` : ''}
              </div>
              <span class="text-gray-400 font-mono">${w.recorded_date}</span>
            </div>
          `;
        });
      } else {
        wContainer.innerHTML = '<p class="text-xs text-gray-400 italic">No previous weight logs.</p>';
      }

      document.getElementById('viewLivestockModal').classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    } catch (err) {
      alert('Error fetching details: ' + err.message);
    }
  }

  async function editLivestock(id) {
    try {
      const res = await fetch('/livestock/api/' + id);
      const json = await res.json();
      if (!json.success) return alert(json.message);

      const d = json.data;
      document.getElementById('editSubtitle').textContent = d.livestock_code;
      document.getElementById('editAnimalName').value = d.animal_name;
      document.getElementById('editBreed').value = d.breed;
      document.getElementById('editWeight').value = d.current_weight;
      document.getElementById('editHealth').value = d.health_status;
      document.getElementById('editValue').value = d.estimated_value;
      document.getElementById('editForm').action = '/livestock/' + d.id + '/update';

      document.getElementById('editLivestockModal').classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    } catch (err) {
      alert('Error loading livestock for edit: ' + err.message);
    }
  }

  function confirmArchive(id, code, name) {
    document.getElementById('archiveCode').textContent = code;
    document.getElementById('archiveAnimalName').textContent = name;
    document.getElementById('archiveForm').action = '/livestock/' + id + '/archive';
    document.getElementById('archiveModal').classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }
</script>

{{> footer }}
