{{> head }}
{{> nav }}

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

  {{#if success_msg}}
  <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
      <p class="font-medium text-sm">{{ success_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  {{#if error_msg}}
  <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
      <p class="font-medium text-sm">{{ error_msg }}</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700">
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>
  {{/if}}

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 gap-4 border-b border-gray-200">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Cooperative Members</h1>
      <p class="text-sm text-gray-500 mt-1">Manage farmer members registered in the KAMBAC Livestock Association</p>
    </div>
    <button onclick="openMemberModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-forest-600 hover:bg-forest-700 text-white font-medium text-sm rounded-xl shadow-sm hover:shadow-md transition-all">
      <i data-lucide="user-plus" class="w-4 h-4"></i>
      <span>Add Member</span>
    </button>
  </div>

  <!-- Members Table -->
  <div class="mt-8">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
          <thead class="bg-gray-50 text-xs font-bold text-gray-500 uppercase tracking-wider">
            <tr>
              <th class="px-6 py-4">Member ID</th>
              <th class="px-6 py-4">Full Name</th>
              <th class="px-6 py-4">Contact Number</th>
              <th class="px-6 py-4">Address</th>
              <th class="px-6 py-4">Livestock Count</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each members}}
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="px-6 py-4 font-mono font-bold text-forest-700">{{ this.member_code }}</td>
              <td class="px-6 py-4 font-bold text-gray-900">{{ this.first_name }} {{ this.last_name }}</td>
              <td class="px-6 py-4 text-gray-600">{{ this.contact_number }}</td>
              <td class="px-6 py-4 text-gray-600 max-w-xs truncate">{{ this.address }}</td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-forest-100 text-forest-800">
                  {{ this.livestock.length }} Head(s)
                </span>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-semibold {{#if (eq this.membership_status 'active')}}bg-emerald-100 text-emerald-800{{else}}bg-gray-100 text-gray-600{{/if}}">
                  {{ this.membership_status }}
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <button onclick="editMemberDetails({{ this.id }}, '{{ this.first_name }}', '{{ this.last_name }}', '{{ this.contact_number }}', '{{ this.address }}', '{{ this.membership_status }}')" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg" title="Edit Member">
                  <i data-lucide="edit-2" class="w-4 h-4"></i>
                </button>
                <form action="/members/{{ this.id }}/toggle" method="POST" class="inline">
                  <button type="submit" class="p-1.5 text-gray-500 hover:bg-gray-100 rounded-lg" title="Toggle Status">
                    <i data-lucide="power" class="w-4 h-4"></i>
                  </button>
                </form>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</main>

<!-- Add Member Modal -->
<div id="memberModal" class="fixed inset-0 z-50 hidden modal-backdrop overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-gray-100">
      
      <div class="bg-forest-800 px-6 py-4 flex items-center justify-between text-white">
        <h3 id="memberModalTitle" class="text-lg font-bold">Register New Member</h3>
        <button onclick="closeMemberModal()" class="text-forest-200 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <form id="memberForm" action="/members" method="POST" class="p-6 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">First Name *</label>
            <input type="text" id="mFirstName" name="first_name" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Last Name *</label>
            <input type="text" id="mLastName" name="last_name" required class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Contact Number</label>
          <input type="text" id="mContact" name="contact_number" placeholder="09xxxxxxxxx" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Residential Address</label>
          <textarea id="mAddress" name="address" rows="2" placeholder="Barangay, Municipality, Province" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 outline-none"></textarea>
        </div>

        <div id="mStatusWrapper" class="hidden">
          <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Membership Status</label>
          <select id="mStatus" name="membership_status" class="w-full px-3.5 py-2 bg-gray-50 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-forest-500 outline-none">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="pending">Pending</option>
          </select>
        </div>

        <div class="pt-4 border-t border-gray-200 flex justify-end gap-3">
          <button type="button" onclick="closeMemberModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-100">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-forest-600 hover:bg-forest-700 text-white rounded-xl text-sm font-semibold shadow-md">Save Member</button>
        </div>
      </form>

    </div>
  </div>
</div>

<script>
  function openMemberModal() {
    document.getElementById('memberModalTitle').textContent = 'Register New Member';
    document.getElementById('memberForm').action = '/members';
    document.getElementById('mFirstName').value = '';
    document.getElementById('mLastName').value = '';
    document.getElementById('mContact').value = '';
    document.getElementById('mAddress').value = '';
    document.getElementById('mStatusWrapper').classList.add('hidden');
    document.getElementById('memberModal').classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  function editMemberDetails(id, fn, ln, contact, addr, status) {
    document.getElementById('memberModalTitle').textContent = 'Edit Member Profile';
    document.getElementById('memberForm').action = '/members/' + id + '/update';
    document.getElementById('mFirstName').value = fn;
    document.getElementById('mLastName').value = ln;
    document.getElementById('mContact').value = contact || '';
    document.getElementById('mAddress').value = addr || '';
    document.getElementById('mStatus').value = status;
    document.getElementById('mStatusWrapper').classList.remove('hidden');
    document.getElementById('memberModal').classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  function closeMemberModal() {
    document.getElementById('memberModal').classList.add('hidden');
  }
</script>

{{> footer }}
