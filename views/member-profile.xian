{{> head}}
<body class="app-body admin-portal">
  <div class="app-shell">
    {{> admin-sidebar}}
    <main class="app-main">
      <header class="topbar"><span class="breadcrumb"><a href="/members">Members</a><span>/</span>Profile</span><span class="topbar-label">MEMBER PROFILE</span></header>
      <section class="page-content">
        <div class="page-heading"><div><p class="eyebrow">{{#if member.isArchived}}ARCHIVED RECORD{{else}}MEMBER RECORD{{/if}}</p><h1>Member profile</h1><p class="page-subtitle">Personal and membership information.</p></div>{{#if canManage}}{{#unless member.isArchived}}<a class="button button-primary" href="/members/{{member.id}}/edit">Edit profile</a>{{/unless}}{{/if}}</div>
        <section class="profile-card">
          <div class="profile-banner"><span class="profile-avatar">{{member.initials}}</span><div><h2>{{member.fullName}}</h2><p>{{member.memberId}}</p></div><span class="status-badge {{#if member.isActive}}status-active{{else}}{{#if member.isSuspended}}status-suspended{{else}}status-inactive{{/if}}{{/if}}"><i></i>{{member.status}}</span></div>
          <div class="profile-content">
            <div class="form-section-title"><span class="form-section-icon">01</span><span><strong>Personal information</strong><small>Member contact details</small></span></div>
            <dl class="profile-grid">
              <div><dt>First name</dt><dd>{{member.firstName}}</dd></div>
              <div><dt>Last name</dt><dd>{{member.lastName}}</dd></div>
              <div><dt>Contact number</dt><dd>{{member.contactNumber}}</dd></div>
              <div class="profile-field-wide"><dt>Complete address</dt><dd>{{member.address}}</dd></div>
            </dl>
            <div class="form-section-title form-section-spaced"><span class="form-section-icon">02</span><span><strong>Membership details</strong><small>Organization membership record</small></span></div>
            <dl class="profile-grid">
              <div><dt>Member ID</dt><dd>{{member.memberId}}</dd></div>
              <div><dt>Membership date</dt><dd>{{member.membershipDate}}</dd></div>
              <div><dt>Status</dt><dd><span class="status-badge {{#if member.isActive}}status-active{{else}}{{#if member.isSuspended}}status-suspended{{else}}status-inactive{{/if}}{{/if}}"><i></i>{{member.status}}</span></dd></div>
              <div><dt>Record created</dt><dd>{{member.createdAt}}</dd></div>
            </dl>
            <div class="form-actions">{{#if member.isArchived}}<a class="button button-secondary" href="/members/archive">Back to archive</a><form method="POST" action="/members/{{member.id}}/restore"><button class="button button-primary" type="submit">Restore record</button></form>{{else}}<a class="button button-secondary" href="/members">Back to directory</a>{{#if canManage}}<a class="button button-primary" href="/members/{{member.id}}/edit">Edit member</a>{{/if}}{{/if}}</div>
          </div>
        </section>
      </section>
    </main>
  </div>
{{> footer }}
