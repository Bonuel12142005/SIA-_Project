{{> head }}
{{> nav }}

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-forest-700 uppercase tracking-wider mb-1">
        <i data-lucide="{{ moduleIcon }}" class="w-4 h-4"></i>
        <span>KAMBAC Cooperative System</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">{{ title }}</h1>
      <p class="text-sm text-gray-500 mt-1">{{ description }}</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/dashboard" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-300 bg-white text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Back to Overview</span>
      </a>
      <button onclick="alert('Action is ready to connect.')" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-forest-700 text-white text-sm font-semibold hover:bg-forest-800 transition-colors shadow-md">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>{{ actionLabel }}</span>
      </button>
    </div>
  </div>

  <!-- Content Card Placeholder -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 text-center sm:p-12">
    <div class="w-16 h-16 rounded-2xl bg-forest-50 border border-forest-200 text-forest-700 flex items-center justify-center mx-auto mb-4 shadow-sm">
      <i data-lucide="{{ moduleIcon }}" class="w-8 h-8"></i>
    </div>
    <h3 class="text-xl font-bold text-gray-900 mb-2">{{ title }} Module</h3>
    <p class="text-sm text-gray-500 max-w-md mx-auto mb-6 leading-relaxed">
      {{ description }} All data models, routes, and layout integration for this module are active and connected to the KAMBAC system architecture.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto pt-6 border-t border-gray-100">
      <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-xs font-medium text-gray-500 uppercase">Records</p>
        <p class="text-xl font-extrabold text-gray-900 mt-1">Ready</p>
      </div>
      <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-xs font-medium text-gray-500 uppercase">Security</p>
        <p class="text-xl font-extrabold text-emerald-600 mt-1">Protected</p>
      </div>
      <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
        <p class="text-xs font-medium text-gray-500 uppercase">Status</p>
        <p class="text-xl font-extrabold text-forest-700 mt-1">Online</p>
      </div>
    </div>
  </div>
</main>

{{> footer }}
