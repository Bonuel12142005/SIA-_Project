<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{{title}} | KAMBAC</title>
  <link rel="stylesheet" href="/tailwind.css">
  <style>
    body { background: #080b10; color: #f5f7fb; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    .panel { background: #111722; border: 1px solid #202938; border-radius: 12px; box-shadow: 0 12px 30px #00000020; }
    aside { background: #0d1218; border-color: #202630; color: #fff; }
    .active { background: #2a2413; color: #f5b400; }
    aside nav a:hover { background: #1d222b; color: #f5b400; }
    header { background: #0d1218; border-color: #202630; }
    .text-green-700, .text-green-800 { color: #f5b400 !important; }
    .text-slate-500 { color: #8d98a8 !important; }
    .text-slate-400 { color: #aab3c0 !important; }
    .border-\[\#dce8df\] { border-color: #202938 !important; }
    .bg-green-100 { background: #2a2413 !important; }
    .nav-section { margin: 0 0 8px; color: #687382; font-size: 10px; font-weight: 700; letter-spacing: .16em; }
    .nav-item { display: flex; align-items: center; gap: 11px; }
    .nav-icon { width: 16px; height: 16px; color: currentColor; }
    .sidebar-footer { margin-top: auto; border-top: 1px solid #202630; padding-top: 18px; }
    .account-layout { display: grid; grid-template-columns: minmax(190px, .7fr) minmax(0, 1.7fr); gap: 16px; }
    .identity-card { text-align: center; }
    .avatar { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto; border-radius: 14px; background: #493514; color: #f5b400; font-size: 22px; font-weight: 800; }
    .role-badge { display: inline-block; margin-top: 10px; padding: 3px 9px; border-radius: 5px; background: #2a2413; color: #f5b400; font-size: 10px; font-weight: 700; text-transform: capitalize; }
    .read-only { border: 1px solid #2b3749; border-radius: 5px; padding: 3px 8px; color: #8d98a8; font-size: 10px; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 34px; }
    .info-label { color: #687382; font-size: 10px; }
    .info-value { margin-top: 3px; color: #f5f7fb; font-size: 13px; }
    .account-notice { border: 1px solid #294c37; border-radius: 7px; background: #12251b; color: #b7d9c0; }
    .account-action { border-top: 1px solid #202938; }
    @media (max-width: 760px) { .account-layout, .info-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body class="min-h-screen">
  <div class="flex min-h-screen">
    <aside class="hidden w-64 shrink-0 border-r p-5 md:block">
      <div class="mb-10 flex items-center gap-3"><div class="grid h-10 w-10 place-items-center rounded-xl bg-white font-black text-green-800">K</div><div><div class="font-bold tracking-wide">KAMBAC</div><div class="text-xs text-green-100">Integrated Management</div></div></div>
      <nav class="space-y-2 text-sm"><p class="nav-section">WORKSPACE</p><a href="/overview" class="nav-item block rounded-lg px-4 py-3 font-semibold text-green-100 hover:bg-green-700 hover:text-white"><span class="nav-icon">▦</span>Overview</a><a href="/products" class="nav-item block rounded-lg px-4 py-3 font-semibold text-green-100 hover:bg-green-700 hover:text-white"><span class="nav-icon">▣</span>Products</a><p class="nav-section mt-8">PERSONAL</p><a href="/account" class="nav-item active block rounded-lg px-4 py-3 font-semibold"><span class="nav-icon">♙</span>My account</a></nav>
      <div class="sidebar-footer"><a href="/logout" class="nav-item block text-sm text-green-100 hover:text-white"><span class="nav-icon">↪</span>Log out</a></div>
    </aside>
    <main class="min-w-0 flex-1">
      <header class="flex items-center justify-between border-b border-[#dce8df] bg-white px-5 py-4 sm:px-8"><p class="text-xs text-slate-500">Workspace <span class="mx-2">/</span> <span class="text-green-700">My account</span></p><span class="text-sm text-slate-400">{{user.name}}</span></header>
      <div class="mx-auto max-w-5xl space-y-6 p-5 sm:p-8">
        {{#if pageError}}<div class="rounded-xl border border-rose-800 bg-rose-950 px-4 py-3 text-sm text-rose-300">{{pageError}}</div>{{/if}}
        <section><p class="text-xs uppercase tracking-[.2em] text-green-700">Your KAMBAC identity</p><h1 class="mt-2 text-3xl font-bold">My account</h1><p class="mt-1 text-sm text-slate-400">Your profile and workspace access, in one place.</p></section>
        <div class="account-layout">
          <section class="panel identity-card p-6">
            <div class="avatar">{{userInitial}}</div>
            <h2 class="mt-4 font-bold">{{user.name}}</h2>
            <p class="text-sm text-slate-400">KAMBAC registered member</p>
            <span class="role-badge">{{user.role}}</span>
          </section>
          <section class="panel p-5 sm:p-6">
            <div class="mb-6 flex items-start justify-between border-b border-[#dce8df] pb-5"><div><h2 class="font-bold">Account information</h2><p class="mt-1 text-xs text-slate-400">Your registered account details.</p></div><span class="read-only">Read only</span></div>
            <div class="info-grid">
              <div><p class="info-label">Full name</p><p class="info-value">{{user.name}}</p></div>
              <div><p class="info-label">Email address</p><p class="info-value">{{user.email}}</p></div>
              <div><p class="info-label">Account ID</p><p class="info-value">#{{user.id}}</p></div>
              <div><p class="info-label">Workspace role</p><p class="info-value capitalize">{{user.role}}</p></div>
            </div>
            <div class="account-notice mt-6 p-4"><p class="font-semibold">♧ &nbsp; Product management</p><p class="mt-1 text-xs">You can manage product records and keep the KAMBAC inventory updated.</p></div>
            <p class="mt-5 text-xs text-slate-500">Account details and role changes are managed by your authorized administrator.</p>
            <div class="account-action mt-5 pt-4"><a href="/logout" class="inline-flex items-center gap-2 rounded-lg border border-[#2b3749] px-4 py-2 text-sm font-semibold text-slate-300 hover:border-[#f5b400] hover:text-[#f5b400]">↪ Sign out</a></div>
          </section>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
