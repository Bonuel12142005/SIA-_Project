<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Member Sign In | KAMBAC</title><link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/kambac.css"><style>:root{color-scheme:light}body{background:#f3f7f4;color:#173524}.auth-card.login-card{background:#fff;border:1px solid #dce8df;border-radius:8px;box-shadow:0 12px 30px rgba(28,79,52,.12)}.brand i{background:#087a55;color:#fff}.brand em,.eyebrow,.required{color:#087a55}.auth-card h1{color:#173524}.auth-card .intro{color:#718078}.field-label{color:#173524}.auth-card.login-card input{background:#fff;border:1px solid #ccdacf;color:#173524}.auth-card.login-card input:focus{border-color:#087a55;outline:2px solid rgba(8,122,85,.12)}.login-card .button{width:100%;margin-top:24px;background:#087a55;color:#fff;border-radius:8px}.login-card .button:hover{background:#066746;color:#fff}.auth-link{color:#087a55}.auth-foot{color:#718078;border-top-color:#e1e8e3}.error{background:#fff1f2;border:1px solid #fecdd3;color:#b91c1c}</style></head><body><main class="auth"><section class="auth-card login-card"><a class="brand" href="/login" aria-label="KAMBAC login"><i>K</i><span>KAMBAC<em>.</em></span></a><div class="eyebrow">MEMBER &amp; OFFICER ACCESS</div><h1>Welcome back</h1><p class="intro">Sign in to the KAMBAC Integrated Management System.</p>{{#if pageError}}<p class="error" role="alert">{{pageError}}</p>{{/if}}<form method="POST" action="/login"><label class="field-label" for="identifier">Email address <span class="required">*</span></label><input id="identifier" type="email" name="identifier" value="{{identifier}}" autocomplete="username" required><label class="field-label" for="password">Password <span class="required">*</span></label><input id="password" name="password" type="password" autocomplete="current-password" required><button class="button" type="submit">Sign in &rarr;</button></form><a class="auth-link" href="/register">New member? Register here</a><div class="auth-foot">For members and authorized officers, including organization leadership and staff.</div></section></main></body></html>