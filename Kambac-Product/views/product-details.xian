<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/tailwind.css"><title>{{product.productName}} | KAMBAC</title><style>body{background:#080b10;color:#f5f7fb;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.panel{background:#111722;border:1px solid #202938;border-radius:12px;box-shadow:0 12px 30px #00000020}.gold{color:#f5b400}.gold-button{background:#f5b400;color:#17120a}.gold-button:hover{background:#ffc629}.badge{border-radius:999px;padding:4px 10px;font-size:11px;font-weight:700}.available{background:#123b2d;color:#7ee2b5}.low_stock{background:#493514;color:#f4c86b}.out_of_stock{background:#4a2026;color:#ff9ca6}.text-slate-400,.text-slate-500{color:#8d98a8!important}.text-slate-200,.text-white{color:#f5f7fb!important}.text-slate-300{color:#aab3c0!important}.border-\[\#203452\]{border-color:#202938!important}</style></head>
<body class="min-h-screen"><main class="mx-auto max-w-4xl p-5 sm:p-10"><div class="mb-8 flex items-center justify-between"><a href="/products" class="text-sm text-slate-400 hover:text-white">← Products</a></div><section class="panel p-6 sm:p-10"><div class="flex flex-col gap-5 border-b border-[#203452] pb-6 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-xs uppercase tracking-[.2em] text-slate-500">{{product.productCode}}</p><h1 class="mt-2 text-3xl font-bold">{{product.productName}}</h1><p class="mt-2 text-slate-400">{{product.category}}</p></div><span class="badge {{product.stockStatus}} capitalize">{{product.stockLabel}}</span></div><dl class="grid gap-6 py-8 sm:grid-cols-2"><div><dt class="text-xs uppercase tracking-wider text-slate-500">Quantity</dt><dd class="mt-1 text-xl font-semibold">{{product.quantity}} <span class="text-sm font-normal text-slate-400">{{product.unit}}</span></dd></div><div><dt class="text-xs uppercase tracking-wider text-slate-500">Price</dt><dd class="mt-1 text-xl font-semibold">₱{{product.price}}</dd></div><div><dt class="text-xs uppercase tracking-wider text-slate-500">Availability</dt><dd class="mt-1 capitalize text-slate-200">{{product.status}}</dd></div><div><dt class="text-xs uppercase tracking-wider text-slate-500">Last updated</dt><dd class="mt-1 text-slate-200">{{product.updatedAt}}</dd></div></dl><div class="border-t border-[#203452] pt-6"><h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Description</h2><p class="mt-3 whitespace-pre-wrap text-slate-300">{{#if product.description}}{{product.description}}{{else}}No description provided.{{/if}}</p></div>{{#if canManage}}<div class="mt-6 flex gap-3 border-t border-[#203452] pt-6"><a href="/products/{{product.id}}/edit" class="gold-button rounded-lg px-4 py-2 text-sm font-bold">Edit product</a><form method="POST" action="/products/{{product.id}}/delete" onsubmit="return confirm('Delete this product?')"><button class="rounded-lg border border-rose-800 px-4 py-2 text-sm font-semibold text-rose-300" type="submit">Delete product</button></form></div>{{/if}}</section></main></body></html>