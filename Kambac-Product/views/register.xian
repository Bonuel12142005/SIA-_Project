<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register | KAMBAC</title><link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/kambac.css"><style>:root{color-scheme:light}body{background:#f3f7f4;color:#173524}.auth-card{background:#fff;border:1px solid #dce8df;border-radius:8px;box-shadow:0 12px 30px rgba(28,79,52,.12)}.brand i{background:#087a55;color:#fff}.brand em,.eyebrow,.required{color:#087a55}.auth-card h1{color:#173524}.auth-card .intro{color:#718078}.field-label{color:#173524}.auth-card input,.auth-card textarea{background:#fff;border:1px solid #ccdacf;color:#173524}.auth-card input:focus,.auth-card textarea:focus{border-color:#087a55;outline:2px solid rgba(8,122,85,.12)}.auth-card .button{width:100%;margin-top:24px;background:#087a55;color:#fff;border-radius:8px}.auth-card .button:hover{background:#066746;color:#fff}.auth-link{color:#087a55}.hint,.auth-foot{color:#718078}.auth-foot{border-top-color:#e1e8e3}.error{background:#fff1f2;border:1px solid #fecdd3;color:#b91c1c}</style></head><body><main class="auth"><section class="auth-card"><a class="brand" href="/login" aria-label="KAMBAC login"><i>K</i><span>KAMBAC<em>.</em></span></a><div class="eyebrow">MEMBER REGISTRATION</div><h1>Create your account</h1><p class="intro">Join the KAMBAC community and complete your member profile.</p>{{#if pageError}}<p class="error" role="alert">{{pageError}}</p>{{/if}}<form method="POST" action="/register"><label class="field-label" for="name">Full name <span class="required">*</span></label><input id="name" name="name" value="{{form.name}}" autocomplete="name" maxlength="255" required><label class="field-label" for="username">Username <span class="required">*</span></label><input id="username" name="username" value="{{form.username}}" autocomplete="username" pattern="[A-Za-z0-9._-]{3,32}" minlength="3" maxlength="32" aria-describedby="username-hint" required><p class="hint" id="username-hint">Use 3&ndash;32 letters, numbers, dots, dashes, or underscores.</p><label class="field-label" for="email">Email address <span class="required">*</span></label><input id="email" name="email" type="email" value="{{form.email}}" autocomplete="email" maxlength="255" required><label class="field-label" for="contactNumber">Contact number <span class="required">*</span></label><input id="contactNumber" name="contactNumber" type="tel" value="{{form.contactNumber}}" placeholder="+63 9XX XXX XXXX" autocomplete="tel" maxlength="30" required><label class="field-label" for="address">Home address <span class="required">*</span></label><textarea id="address" name="address" autocomplete="street-address" maxlength="1000" required>{{form.address}}</textarea><label class="field-label" for="password">Password <span class="required">*</span></label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required><p class="hint">Use at least 8 characters.</p><button class="button" type="submit">Create account</button></form><a class="auth-link" href="/login">Already have an account? Log in</a></section></main></body></html>