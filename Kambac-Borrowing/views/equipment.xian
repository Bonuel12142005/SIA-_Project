{{> head}}
<body class="app-page equipment-page equipment-list-page">
  <div class="app-layout">
    {{> top-navbar}}
    <main class="app-main">
      {{#unless archivedPage}}
        <header class="page-header inventory-header">
          <div>
            <p class="eyebrow">Inventory</p>
            <p class="muted-text inventory-subtitle">Registered equipment and quantity on hand.</p>
          </div>
        </header>

        <dialog class="borrow-dialog add-equipment-dialog" id="add-equipment-dialog" aria-labelledby="add-equipment-dialog-title">
          <div class="borrow-dialog-card">
            <header class="borrow-dialog-header">
              <h2 id="add-equipment-dialog-title">Add Equipment</h2>
              <button class="borrow-dialog-close" type="button" aria-label="Close dialog" data-close-add-equipment>&times;</button>
            </header>

            <form class="equipment-form" method="POST" enctype="multipart/form-data" action="/equipment">
              <div class="add-equipment-form-grid">
                <label class="form-field">
                  <span>Equipment name <span class="required-mark">*</span></span>
                  <input type="text" name="name" maxlength="120" placeholder="Enter equipment name" required>
                </label>
                <label class="form-field">
                  <span>Category <span class="required-mark">*</span></span>
                  <select name="category" required>
                    <option value="">Select category</option>
                    {{#each addEquipmentCategories}}
                      <option value="{{value}}">{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label class="form-field">
                  <span>Description</span>
                  <textarea name="description" rows="2" placeholder="Equipment description"></textarea>
                </label>
                <label class="form-field">
                  <span>Total quantity <span class="required-mark">*</span></span>
                  <input type="number" name="totalQuantity" min="0" max="2147483647" step="1" placeholder="0" required>
                </label>
                <label class="form-field form-field-wide">
                  <span>Equipment photo <span class="required-mark">*</span></span>
                  <div class="add-equipment-photo-row">
                    <div class="equipment-photo-preview-container add-equipment-photo-preview">
                      <img class="equipment-photo-preview" data-photo-preview alt="Equipment photo preview" hidden>
                      <div class="equipment-photo-placeholder" data-photo-placeholder>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                        <span>Photo preview</span>
                      </div>
                    </div>
                    <div class="add-equipment-photo-actions">
                      <input class="add-equipment-file-input" type="file" name="photo" accept="image/jpeg,image/png,image/gif" required>
                      <button class="add-equipment-choose-photo" type="button" data-choose-equipment-photo>Choose Photo</button>
                      <small>PNG, JPG, GIF up to 5MB</small>
                    </div>
                  </div>
                </label>
              </div>

              <footer class="form-actions add-equipment-form-actions">
                <button class="secondary-button" type="button" data-close-add-equipment>Cancel</button>
                <button class="primary-button" type="submit">Add Equipment</button>
              </footer>
            </form>
          </div>
        </dialog>
      {{/unless}}

      {{#each success_msg}}
        <p class="notice notice-success" role="status">{{this}}</p>
      {{/each}}
      {{#each error_msg}}
        <p class="notice notice-error" role="alert">{{this}}</p>
      {{/each}}

      {{#unless archivedPage}}
        <section class="inventory-stats" aria-label="Inventory summary">
          <a class="stat-card" href="/equipment">
            <span class="stat-label">Active items</span>
            <strong>{{counts.total}}</strong>
            <span class="dashboard-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5v9L12 21l-9-4.5v-9L12 3Z"/><path d="m3.5 7.7 8.5 4.4 8.5-4.4M12 12.1V21"/></svg>
            </span>
          </a>
          <a class="stat-card" href="/equipment?availability=available">
            <span class="stat-label">Available units</span>
            <strong>{{counts.available}}</strong>
            <span class="dashboard-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg>
            </span>
          </a>
          <a class="stat-card" href="/equipment?availability=borrowed">
            <span class="stat-label">Borrowed units</span>
            <strong>{{counts.borrowed}}</strong>
            <span class="dashboard-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h11l-3-3"/><path d="M17 17H6l3 3"/><path d="M18 7a7 7 0 0 1 1 9M6 17a7 7 0 0 1-1-9"/></svg>
            </span>
          </a>
          <a class="stat-card" href="/equipment?availability=archived">
            <span class="stat-label">Archived items</span>
            <strong>{{counts.archived}}</strong>
            <span class="dashboard-stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v13H3zM2 4h20v3H2z"/><path d="M10 11h4"/></svg>
            </span>
          </a>
        </section>
      {{/unless}}

      <section class="inventory-panel" aria-labelledby="inventory-list-title">
        <div class="panel-heading">
          <div>
            <h2 id="inventory-list-title">Equipment items</h2>
            <p class="muted-text">{{pagination.total}} item(s) in this view</p>
          </div>
        </div>

        <form class="inventory-filters" method="GET" action="/equipment">
          <label class="filter-search">
            <span class="visually-hidden">Search by equipment name</span>
            <input type="search" name="search" value="{{filters.search}}" placeholder="Search equipment name">
          </label>
          <label>
            <span class="visually-hidden">Category</span>
            <select name="category">
              <option value="">All categories</option>
              {{#each categories}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span class="visually-hidden">Availability</span>
            <select name="availability">
              <option value="">Active inventory</option>
              <option value="available" {{#if filters.isAvailable}}selected{{/if}}>Available</option>
              <option value="borrowed" {{#if filters.isBorrowed}}selected{{/if}}>Borrowed</option>
              <option value="unavailable" {{#if filters.isUnavailable}}selected{{/if}}>Unavailable</option>
              <option value="archived" {{#if filters.isArchived}}selected{{/if}}>Archived</option>
            </select>
          </label>
          <label>
            <span class="visually-hidden">Sort records by</span>
            <select name="sort">
              <option value="createdAt" {{#if filters.sortCreated}}selected{{/if}}>Date added</option>
              <option value="updatedAt" {{#if filters.sortUpdated}}selected{{/if}}>Recently updated</option>
              <option value="name" {{#if filters.sortName}}selected{{/if}}>Name</option>
              <option value="category" {{#if filters.sortCategory}}selected{{/if}}>Category</option>
              <option value="totalQuantity" {{#if filters.sortTotal}}selected{{/if}}>Total quantity</option>
              <option value="availableQuantity" {{#if filters.sortAvailable}}selected{{/if}}>Available quantity</option>
            </select>
          </label>
          <label>
            <span class="visually-hidden">Sort direction</span>
            <select name="direction">
              <option value="desc" {{#if filters.descending}}selected{{/if}}>Descending</option>
              <option value="asc" {{#if filters.ascending}}selected{{/if}}>Ascending</option>
            </select>
          </label>
          <div class="equipment-filter-actions">
            <button class="filter-button" type="submit">Apply</button>
            {{#unless archivedPage}}
            <button class="primary-button filter-add-equipment" type="button" aria-haspopup="dialog" aria-controls="add-equipment-dialog" data-open-add-equipment>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              <span>+ Add Equipment</span>
            </button>
            {{/unless}}
            <a class="clear-filters" href="/equipment">Clear</a>
          </div>
        </form>

        {{#if items.length}}
          <div class="table-scroll">
            <table class="inventory-table">
              <thead>
                <tr>
                  <th scope="col">Photo</th>
                  <th scope="col">Equipment</th>
                  <th scope="col">Category</th>
                  <th scope="col">Quantity</th>
                  <th scope="col">Condition</th>
                  <th scope="col">Availability</th>
                  <th scope="col">Date added</th>
                  <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {{#each items}}
                  <tr
                    data-equipment-id="{{id}}"
                    data-equipment-name="{{name}}"
                    data-equipment-category="{{category}}"
                    data-equipment-status="{{statusLabel}}"
                    data-equipment-total="{{totalQuantity}}"
                    data-equipment-available="{{availableQuantity}}"
                    data-equipment-borrowed="{{borrowedQuantity}}"
                    data-equipment-condition="{{conditionLabel}}"
                    data-equipment-date="{{createdDate}}"
                    data-equipment-description="{{description}}"
                    data-equipment-photo="{{photoPath}}"
                    data-equipment-minimum="{{borrowedQuantity}}"
                  >
                  <td>
                    {{#if photoPath}}
                      <img class="equipment-thumbnail" src="{{photoPath}}" alt="Photo of {{name}}" loading="lazy">
                    {{else}}
                      <span class="equipment-thumbnail-placeholder" aria-label="No photo available">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                      </span>
                    {{/if}}
                  </td>
                  <td><button class="table-primary-link equipment-details-open" type="button" aria-haspopup="dialog" aria-controls="equipment-details-dialog" data-open-equipment-details>{{name}}</button></td>
                    <td>{{category}}</td>
                    <td><span class="quantity-cell">{{availableQuantity}} / {{totalQuantity}}</span><span class="table-secondary">{{borrowedQuantity}} borrowed</span></td>
                    <td>{{conditionLabel}}</td>
                    <td><span class="status-badge">{{statusLabel}}</span></td>
                    <td>{{createdDate}}</td>
                    <td>
                      <div class="row-actions">
                        <button
                          class="row-action"
                          type="button"
                          aria-haspopup="dialog"
                          aria-controls="equipment-details-dialog"
                          data-open-equipment-details
                        >View</button>
                        <span aria-hidden="true">|</span>
                        <form method="POST" action="/equipment/{{id}}/status">
                          {{#if isActive}}
                          <button class="row-action row-action-archive" type="submit">Archive</button>
                          {{else}}
                          <button class="row-action row-action-activate" type="submit">Activate</button>
                          {{/if}}
                        </form>
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <div class="pagination">
            <span class="muted-text">Showing {{pagination.start}}–{{pagination.end}} of {{pagination.total}}</span>
            <div class="pagination-actions">
              {{#if pagination.previousUrl}}<a class="secondary-button" href="{{pagination.previousUrl}}">Previous</a>{{/if}}
              <span class="page-count">Page {{pagination.page}} of {{pagination.totalPages}}</span>
              {{#if pagination.nextUrl}}<a class="secondary-button" href="{{pagination.nextUrl}}">Next</a>{{/if}}
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <span class="empty-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5v9L12 21l-9-4.5v-9L12 3Z"/><path d="m3.5 7.7 8.5 4.4 8.5-4.4M12 12.1V21"/></svg>
            </span>
            <h3>{{emptyTitle}}</h3>
            <p class="muted-text">{{emptyMessage}}</p>
            {{#if emptyIsUnfiltered}}<button class="primary-button" type="button" aria-haspopup="dialog" aria-controls="add-equipment-dialog" data-open-add-equipment>Add the first item</button>{{else}}<a class="secondary-button" href="/equipment">Clear filters</a>{{/if}}
          </div>
        {{/if}}
      </section>
      <dialog class="borrow-dialog equipment-details-dialog" id="equipment-details-dialog" aria-labelledby="equipment-details-title">
        <div class="borrow-dialog-card">
          <header class="borrow-dialog-header">
            <h2 id="equipment-details-title">Equipment Details</h2>
            <button class="borrow-dialog-close" type="button" aria-label="Close dialog" data-close-equipment-details>&times;</button>
          </header>
          <div class="equipment-details-content">
            <div class="equipment-details-image-wrap">
              <img data-details-photo alt="" hidden>
              <span class="equipment-thumbnail-placeholder" data-details-photo-placeholder aria-label="No photo available">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </span>
            </div>
            <div class="equipment-details-primary">
              <h3 data-details-name></h3>
              <p data-details-category></p>
              <span class="status-badge" data-details-status></span>
            </div>
            <dl class="equipment-details-grid">
              <div><dt>Total quantity</dt><dd data-details-total></dd></div>
              <div><dt>Available quantity</dt><dd data-details-available></dd></div>
              <div><dt>Borrowed quantity</dt><dd data-details-borrowed></dd></div>
              <div><dt>Condition</dt><dd data-details-condition></dd></div>
              <div><dt>Date added</dt><dd data-details-date></dd></div>
              <div class="equipment-details-description"><dt>Description</dt><dd data-details-description></dd></div>
            </dl>
          </div>
          <footer class="equipment-details-actions">
            <button class="secondary-button" type="button" data-close-equipment-details>Close</button>
            <button class="primary-button" type="button" data-open-edit-from-details>Edit Item</button>
          </footer>
        </div>
      </dialog>

      <dialog class="borrow-dialog equipment-edit-dialog" id="equipment-edit-dialog" aria-labelledby="equipment-edit-title">
        <div class="borrow-dialog-card">
          <header class="borrow-dialog-header">
            <h2 id="equipment-edit-title">Edit Equipment</h2>
            <button class="borrow-dialog-close" type="button" aria-label="Close dialog" data-close-equipment-edit>&times;</button>
          </header>
          <form class="equipment-form equipment-edit-form" method="POST" enctype="multipart/form-data" data-edit-equipment-form>
            <input type="hidden" name="returnTo" value="inventory">
            <label class="form-field">
              <span>Equipment name <span class="required-mark">*</span></span>
              <input type="text" name="name" maxlength="120" required data-edit-equipment-name>
            </label>
            <label class="form-field">
              <span>Category <span class="required-mark">*</span></span>
              <input type="text" name="category" maxlength="80" required data-edit-equipment-category>
            </label>
            <label class="form-field">
              <span>Total quantity <span class="required-mark">*</span></span>
              <input type="number" name="totalQuantity" min="0" max="2147483647" step="1" required data-edit-equipment-total>
              <small data-edit-equipment-borrowed></small>
            </label>
            <label class="form-field">
              <span>Description</span>
              <textarea name="description" rows="2" placeholder="Equipment description" data-edit-equipment-description></textarea>
            </label>
            <label class="form-field form-field-wide">
              <span>Equipment photo <span class="optional-label">(optional)</span></span>
              <div class="equipment-photo-preview-container add-equipment-photo-preview">
                <img class="equipment-photo-preview" data-photo-preview alt="Equipment photo preview" hidden>
                <div class="equipment-photo-placeholder" data-photo-placeholder>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  <span>Current equipment photo</span>
                </div>
              </div>
              <button class="add-equipment-choose-photo" type="button" data-choose-equipment-photo>Choose New Photo</button>
              <input class="add-equipment-file-input" type="file" name="photo" accept="image/jpeg,image/png,image/gif" data-choose-equipment-photo-input>
              <small>PNG, JPG, or GIF; maximum file size 5 MB.</small>
            </label>
            <footer class="form-actions add-equipment-form-actions">
              <button class="secondary-button" type="button" data-close-equipment-edit>Cancel</button>
              <button class="primary-button" type="submit">Save Changes</button>
            </footer>
          </form>
        </div>
      </dialog>
      {{#unless archivedPage}}
      <section class="inventory-panel borrowing-records-panel" aria-labelledby="borrowing-records-title">
        <div class="panel-heading borrowing-records-heading">
          <h2 id="borrowing-records-title">Borrowing Records</h2>
          <button class="primary-button borrowing-new-button" type="button" aria-haspopup="dialog" aria-controls="new-borrowing-dialog" data-open-new-borrowing>+ New Borrowing</button>
        </div>
        <div class="table-scroll">
          <table class="inventory-table borrowing-records-table">
            <thead>
              <tr>
                <th scope="col">Borrower</th>
                <th scope="col">Equipment</th>
                <th scope="col">Quantity</th>
                <th scope="col">Date Borrowed</th>
                <th scope="col">Expected Return</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {{#if borrowings.length}}
                {{#each borrowings}}
                <tr>
                  <td>{{borrowerName}}</td>
                  <td>{{equipmentName}}</td>
                  <td>{{quantity}}</td>
                  <td>{{borrowedDate}}</td>
                  <td>{{dueDate}}</td>
                  <td><span class="borrowing-status {{statusClass}}">{{statusLabel}}</span></td>
                  <td>
                    {{#unless isReturned}}
                    <form method="POST" action="/equipment/{{equipmentId}}/borrowings/{{id}}/return">
                      <button class="row-action" type="submit">Return</button>
                    </form>
                    {{else}}<span class="muted-text">—</span>{{/unless}}
                  </td>
                </tr>
                {{/each}}
              {{else}}
                <tr><td colspan="7" class="borrowing-empty">No borrowing records yet.</td></tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </section>
      {{/unless}}
      {{#unless archivedPage}}
      <dialog class="borrow-dialog equipment-borrow-dialog" id="new-borrowing-dialog" aria-labelledby="new-borrowing-dialog-title">
        <div class="borrow-dialog-card">
          <header class="borrow-dialog-header">
            <h2 id="new-borrowing-dialog-title">New Equipment Borrowing</h2>
            <button class="borrow-dialog-close" type="button" aria-label="Close dialog" data-close-new-borrowing>&times;</button>
          </header>
          <form class="borrow-modal-form equipment-borrow-form" method="POST" data-new-borrowing-form>
            {{#if borrowableItems.length}}
            <label class="borrow-field borrow-field-wide">
              <span>Equipment</span>
              <select name="equipmentId" required data-new-borrowing-equipment>
                <option value="">Select available equipment</option>
                {{#each borrowableItems}}
                <option value="{{id}}" data-available-quantity="{{availableQuantity}}">{{name}} ({{availableQuantity}} available)</option>
                {{/each}}
              </select>
              <small data-new-borrowing-availability>Select an item to see availability.</small>
            </label>
            <label class="borrow-field borrow-field-wide">
              <span>Borrower name</span>
              <input type="text" name="borrowerName" maxlength="120" autocomplete="name" required>
            </label>
            <label class="borrow-field">
              <span>Quantity</span>
              <input type="number" name="quantity" min="1" value="1" step="1" required data-new-borrowing-quantity>
            </label>
            <label class="borrow-field">
              <span>Expected return date</span>
              <input type="date" name="dueDate" min="{{todayDate}}" required>
            </label>
            <input type="hidden" name="returnTo" value="inventory">
            <footer class="borrow-modal-actions equipment-borrow-actions">
              <button class="secondary-button" type="button" data-close-new-borrowing>Cancel</button>
              <button class="primary-button" type="submit">Submit Borrowing</button>
            </footer>
            {{else}}
            <p class="borrow-modal-empty">Walang kagamitang available na hiramin sa ngayon.</p>
            <footer class="borrow-modal-actions equipment-borrow-actions">
              <button class="secondary-button" type="button" data-close-new-borrowing>Close</button>
            </footer>
            {{/if}}
          </form>
        </div>
      </dialog>
      {{/unless}}
    </main>
  </div>
{{> footer}}
